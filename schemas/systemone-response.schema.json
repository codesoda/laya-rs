{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laya-rs.dev/schemas/systemone-response.schema.json",
  "title": "TypeSafe SystemOne response",
  "description": "Derived from typesafe-ai/typesafe-sdk-js 66880ccded6cb642dc1809620c2b108c33730214 src/types.ts:72-142 and the Vercel adapter response parser at vercel/ai 20dd00abba618d5a516e0fee40ccd3e18a2bd1fb packages/typesafe-ai/src/typesafe-ai-evaluation-api.ts:6-32.",
  "$defs": {
    "choiceAnswer": {
      "type": "object",
      "properties": {
        "type": { "const": "choice" },
        "choice": { "type": "string" },
        "confidence": { "type": "number" },
        "probabilities": { "type": "object", "additionalProperties": { "type": "number" } }
      },
      "required": ["type", "choice", "confidence", "probabilities"]
    },
    "scoreAnswer": {
      "type": "object",
      "properties": {
        "type": { "const": "score" },
        "score": { "type": "number" },
        "confidence": { "type": "number" },
        "legend": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
        "probabilities": { "type": "object", "additionalProperties": { "type": "number" } }
      },
      "required": ["type", "score", "confidence", "legend", "probabilities"]
    },
    "noulAnswer": {
      "type": "object",
      "properties": { "type": { "const": "noul" }, "noul": { "type": "number" } },
      "required": ["type", "noul"]
    },
    "jsonValue": {
      "anyOf": [
        { "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "answer": { "oneOf": [{ "$ref": "#/$defs/choiceAnswer" }, { "$ref": "#/$defs/scoreAnswer" }, { "$ref": "#/$defs/noulAnswer" }] }
  },
  "type": "object",
  "properties": {
    "model": { "type": "string" },
    "answers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/answer" } },
    "usage": {
      "type": "object",
      "properties": { "input_tokens": { "type": "number" }, "output_tokens": { "type": "number" } },
      "required": ["input_tokens", "output_tokens"],
      "additionalProperties": false
    }
  },
  "required": ["model", "answers", "usage"],
  "additionalProperties": false
}
