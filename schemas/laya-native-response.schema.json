{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laya-rs.dev/schemas/laya-native-response.schema.json",
  "title": "Laya native SystemOne response",
  "description": "Laya-specific extension derived from /Users/chrisraethke/projects/laya-rs/.cache/src/laya/laya/agent.py:312-370. These fields are not part of the upstream TypeSafe SDK response contract.",
  "$defs": {
    "action": {
      "type": "object",
      "properties": { "act_probability": { "type": "number" } },
      "required": ["act_probability"],
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "properties": {
        "type": { "const": "choice" },
        "choice": { "type": "string" },
        "probabilities": { "type": "object", "additionalProperties": { "type": "number" } },
        "confidence": { "type": "number" },
        "action": { "$ref": "#/$defs/action" }
      },
      "required": ["type", "choice", "probabilities", "confidence", "action"],
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "properties": {
        "type": { "const": "score" },
        "score": { "type": "number" },
        "legend": { "type": "object", "additionalProperties": {} },
        "probabilities": { "type": "object", "additionalProperties": { "type": "number" } },
        "confidence": { "type": "number" },
        "action": { "$ref": "#/$defs/action" }
      },
      "required": ["type", "score", "legend", "probabilities", "confidence", "action"],
      "additionalProperties": false
    },
    "noul": {
      "type": "object",
      "properties": {
        "type": { "const": "noul" },
        "noul": { "type": "number" },
        "confidence": { "type": "number" },
        "action": { "$ref": "#/$defs/action" }
      },
      "required": ["type", "noul", "confidence", "action"],
      "additionalProperties": false
    },
    "answer": { "oneOf": [{ "$ref": "#/$defs/choice" }, { "$ref": "#/$defs/score" }, { "$ref": "#/$defs/noul" }] }
  },
  "type": "object",
  "properties": {
    "model": { "const": "laya-rl-agent" },
    "answers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/answer" } },
    "usage": {
      "type": "object",
      "properties": { "input_tokens": { "type": "integer" }, "output_tokens": { "const": 0 } },
      "required": ["input_tokens", "output_tokens"],
      "additionalProperties": false
    }
  },
  "required": ["model", "answers", "usage"],
  "additionalProperties": false
}
